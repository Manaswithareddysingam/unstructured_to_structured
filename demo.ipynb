# -------------------------
# 4. Demo: Sending requests
# -------------------------
import requests

# Example 1: Create a task from text
task_data = {"text": "Prepare quarterly sales report"}
resp = requests.post(f"{public_url}/create_task", data=task_data)
print("Task response:", resp.json())

# Example 2: Create a note
note_data = {"text": "Team meeting at 3 PM"}
resp = requests.post(f"{public_url}/create_note", data=note_data)
print("Note response:", resp.json())

# Example 3: Create an invoice from an image
from PIL import Image
img = Image.open("sample_invoice.png")  # Upload a sample invoice in Colab
resp = requests.post(f"{public_url}/create_invoice", files={"file": open("sample_invoice.png","rb")})
print("Invoice response:", resp.json())

# Example 4: Create an issue
issue_data = {"text": "Fix broken link on homepage"}
resp = requests.post(f"{public_url}/create_issue", data=issue_data)
print("Issue response:", resp.json())

